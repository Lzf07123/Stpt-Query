log_format privacy '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $uri $server_protocol" $status '
                   '$body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    server_name _;

    listen 8080;
    server_tokens off;
    access_log /dev/stdout privacy;

    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-DIcJv9zUX/pnA3GFnUMOhDwaaS7IpPVKTp651n/piMc='; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    root /usr/share/nginx/html;
    index index.html;

    location = /brand-env.js {
        root /tmp/brand;
        expires -1;
    }

    # 首页 HTML 承载缓存版本号，禁止浏览器长时间保留旧入口。
    location = / {
        try_files /index.html =404;
        expires epoch;
    }

    # 直连 /index.html 与 /admin.html 同样禁止缓存（否则 1h 缓存会卡住新版入口）。
    # 注意：这两个 location 不自建 add_header，继续继承 server 级 CSP/安全头。
    location = /index.html {
        try_files /index.html =404;
        expires epoch;
    }

    location = /admin.html {
        try_files /admin.html =404;
        expires epoch;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires 1h;
    }

    location = /admin {
        root /usr/share/nginx/html;
        try_files /admin.html =404;
        # 注意：nginx 的 add_header 会覆盖继承 —— 这里若自建 Cache-Control，
        # 会连带丢掉 server 级 CSP/安全头，因此用 expires 控制缓存
        expires epoch;
    }

    location = /metrics {
        return 404;
    }

    # 管理端浏览器凭据必须原样透传；这里禁止服务端注入公共网关令牌。
    location ^~ /admin/api/ {
        proxy_pass http://app:8000/admin/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization $http_authorization;
        proxy_http_version 1.1;
        proxy_read_timeout 15s;
        client_max_body_size 16k;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # 日历订阅 API：浏览器调用，服务端注入网关令牌（与 /run 同级信任模型）。
    location ^~ /api/v1/calendars {
        # 边缘限流挡板（10r/s burst=20，宽松值）：业务限流由 app 层负责，
        # 只拦截突发刷量；订阅 ICS /cal/ 与公开只读路径不限流
        limit_req zone=perip burst=20 nodelay;
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
        client_max_body_size 16k;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    # 日历订阅源：URL 内含长期密钥，禁止记录访问日志，也不注入网关令牌。
    location ^~ /cal/ {
        access_log off;
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Content-Security-Policy;
    }

    # 查询串包含一次性个人票号；不在边缘日志保留这些 URL。
    location = /jump/go {
        access_log off;
        # 边缘限流挡板（10r/s burst=20，宽松值）：业务限流由 app 层负责
        limit_req zone=perip burst=20 nodelay;
        # 桥接页是一次性内联脚本；精确哈希避免继承静态站点 CSP 后脚本被拦截。
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-OH8gUQ7Q9SYCDbphqBc7Cs4B7CWHxFl43qPdr39Enns='; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        expires epoch;
        client_max_body_size 2m;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Content-Security-Policy;
    }

    location = /get_schedule/export {
        access_log off;
        # 边缘限流挡板（10r/s burst=20，宽松值）：业务限流由 app 层负责
        limit_req zone=perip burst=20 nodelay;
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Content-Security-Policy;
    }

    # 业务查询/异步任务入口：边缘限流挡板（10r/s burst=20，宽松值）。
    # 分工：这里只按真实客户端 IP 拦截突发刷量/重放；业务级限流（30/min/IP）
    # 由 app 层 RATE_LIMIT 负责，两级互不替代。
    location ~ ^/(run(?:/jobs(?:/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])?)?|v1/workflows/run)$ {
        limit_req zone=perip burst=20 nodelay;
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Content-Security-Policy;
        expires epoch;
    }

    # 公开只读路径（健康检查/服务状态/通知轮询/课表导出别名）：不做边缘限流，
    # 健康探针与日历客户端会高频轮询；/jump/* 与 /get_schedule/* 的具体入口
    # 已在上方精确 location 单独限流
    location ~ ^/(service-status|notices(?:/active|/history)|health(/.*)?|jump(/.*)?|get_schedule/export)$ {
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Authorization "Bearer ${API_TOKEN}";
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Cross-Origin-Opener-Policy;
        proxy_hide_header Content-Security-Policy;
        expires epoch;
    }
}
