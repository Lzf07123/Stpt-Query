# ===== 编排服务自身 =====
ENVIRONMENT=development
# 生产环境必须 AUTO_ROTATE_TOKEN=false 并配置固定 API_TOKEN（多副本一致）
AUTO_ROTATE_TOKEN=true
API_TOKEN=

# ===== 上游教务服务（get-infomation-service）=====
SERVICE_BASE_URL=https://school.lizf.cn
SERVICE_API_TOKEN=
# 上游调用超时（秒）
SERVICE_TIMEOUT=60

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 成绩分析：确定性输出 + 长度上限
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# ===== 网关行为 =====
RATE_LIMIT=30
# 可选：多实例共享限流与状态历史（redis://:password@host:6379/0）
REDIS_URL=
