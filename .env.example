# ===== 格式化后端（format-service，对外入口）=====
ENVIRONMENT=development
# 静态前端 + 多副本部署要求固定令牌：保持 false，前端与后端共用 API_TOKEN
AUTO_ROTATE_TOKEN=false
API_TOKEN=change-me
# 独立后台查询凭据；留空时后台 API 完全禁用。生产至少 16 字符且不得复用网关令牌
ADMIN_TOKEN=
# 每 IP 每分钟查询上限
RATE_LIMIT=30
# format-service 位于 nginx 之后（唯一对外入口）：启用后按 X-Forwarded-For 首段限流；
# nginx 模板已用 $remote_addr 覆盖 XFF，防伪造。直连暴露 format-service 时必须保持 false
TRUST_PROXY=true
# 多副本共享限流/状态历史/查询日志的 Redis 连接串；留空 = 单实例内存模式
REDIS_URL=
# 查询日志双写中的文件通道：JSONL 追加写入，按大小轮转
FILE_LOG_ENABLED=true
FILE_LOG_PATH=/var/log/edu-query/queries.jsonl
FILE_LOG_MAX_BYTES=52428800
FILE_LOG_BACKUP_COUNT=7
# /run 总耗时预算；超时后返回可重试的业务失败
REQUEST_TIMEOUT=100
# 全局并发槽位等待秒数；槽位等待超时返回 503
CONCURRENCY_WAIT_TIMEOUT=2
# format-service 同时处理的最大查询数（对学校上游的并发保护）
GLOBAL_CONCURRENCY=4
# 容器时区（影响查询日志 time 字段的偏移）
TZ=Asia/Shanghai
# 资源监控宿主机 /proc 只读挂载；Compose 已默认挂载，Docker Desktop 时范围是 Linux VM
HOST_PROC_ROOT=/host/proc
# 资源监控宿主机 cgroup v2 只读挂载；用于聚合整个编排的容器内存
HOST_CGROUP_ROOT=/host/sys/fs/cgroup

# ===== 镜像构建与下载加速 =====
# 镜像仓库前缀：国内环境可填镜像加速站（如 docker.m.daocloud.io 或云镜像仓库），
# 留空则使用 Docker Hub 官方镜像
IMAGE_REGISTRY=
# 构建期 pip 下载源（PyPI 镜像可加速；默认官方源）
PIP_INDEX_URL=https://pypi.org/simple
# 前端本地构建 npm 源（可选）：cd frontend && npm config set registry <镜像> && npm install
# 常用镜像：https://registry.npmmirror.com

# ===== 品牌文案（可选覆盖；留空使用 brand.js 内置默认值）=====
# 页面标题 / 主标题（默认「教务信息查询」）
BRAND_NAME=
# 标题下的一句话定位（默认「汕职院教务信息查询」）
BRAND_SLOGAN=
# 页面 meta description（默认内置说明）
BRAND_DESCRIPTION=
# 页脚版权作者（默认 Lzf07123）
BRAND_AUTHOR=
# 页脚 GitHub 链接（默认 https://github.com/Lzf07123/STPT-Query）；填 none 隐藏该链接
BRAND_GITHUB=

# ===== 对外入口（浏览器可见地址）=====
# 免密登录 /jump/go 与课表下载 /get_schedule/export 链接以此地址生成；
# 生产部署改成公网域名（含 https 与端口），本地默认 127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ===== 查询代理（get-infomation-service）=====
# 留空时，Compose 内自动指向内部服务 http://get-infomation-service:8766；
# 仅在独立部署（format-service 与查询代理分机）时填公网地址
SERVICE_BASE_URL=
SERVICE_API_TOKEN=change-me
SERVICE_TIMEOUT=60
# 查询代理多副本共享状态；留空 = 单实例内存模式。与上面的 REDIS_URL 可指向同一 Redis
JWXT_REDIS_URL=

# ===== LLM（OpenAI 兼容协议，默认智谱 GLM）=====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash
# 成绩分析：确定性输出 + 长度上限
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
# 成绩分析 LLM 单次请求超时秒数
LLM_TIMEOUT=60
# 智谱 GLM 深度思考开关；关闭可降低延迟，true/false
LLM_ENABLE_THINKING=true
# 覆盖成绩分析系统提示词；留空使用 prompts.py 内置提示词。支持引号包裹的多行文本
LLM_SYSTEM_PROMPT=
