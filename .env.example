# ===== Compose 编排内 Redis 开关 =====
# 留空：不启动编排内 Redis（仅适合单副本）。
# 设为 redis：启动编排内 Redis，并把 REDIS_URL/JWXT_REDIS_URL 指向 redis://redis:...
# 双副本默认建议使用 redis；使用外部 Redis 时保持留空并填写下方两个 URL。
# 该变量由 Docker Compose 自身读取；format-service 的 Settings 会忽略未知变量。
COMPOSE_PROFILES=redis

# ===== 双副本部署 =====
# format-service 副本数；大于 1 时必须启用共享 Redis。
FORMAT_REPLICAS=2
# 应用镜像版本标签；生产必须使用发布版本/提交短 SHA，避免 latest
APP_IMAGE_TAG=1.0.0

# ===== 格式化后端（format-service，对外入口）=====
ENVIRONMENT=development
# 静态前端 + 多副本部署要求固定令牌：保持 false，前端与后端共用 API_TOKEN
AUTO_ROTATE_TOKEN=false
API_TOKEN=change-me
# 独立后台查询凭据；留空时后台 API 完全禁用。生产至少 16 字符且不得复用网关令牌
ADMIN_TOKEN=
# 每 IP 每分钟查询上限
RATE_LIMIT=30
# format-service 默认位于 nginx 之后（默认唯一对外入口）：启用后按 X-Forwarded-For 首段限流；
# nginx 先按 TRUSTED_PROXY_CIDR 恢复真实客户端 IP，再用 $remote_addr 覆盖 XFF，防伪造。
# 直连暴露 format-service 时必须保持 false
TRUST_PROXY=true
# 外层反代来源 IP/CIDR。默认覆盖 Docker 内部反代；宿主/局域网反代需改成其实际来源
TRUSTED_PROXY_CIDR=172.16.0.0/12
# format-service 仅在连接来源命中这些 CIDR 时信任 XFF；多个 CIDR 用英文逗号分隔
TRUSTED_PROXY_CIDRS=172.16.0.0/12
# 多副本共享限流/查询日志/异步任务的 Redis 连接串；留空 = 单实例内存模式。
# 编排内示例：redis://redis:6379/0；外部示例：redis://redis.internal:6379/0
REDIS_URL=redis://redis:6379/0
# 分布式锁与实例标识；留空默认用容器 hostname。多副本必须能解析出不同值
INSTANCE_ID=
# Redis 暂不可用后，每副本扫描本地 WAL 并幂等回填的间隔秒数
HISTORY_SYNC_INTERVAL_SECONDS=60
# 异步任务 worker（每 format-service 副本）；总活跃任务 = 副本数 × JOB_WORKERS，
# 并受每副本 GLOBAL_CONCURRENCY 与查询代理 JWXT_UPSTREAM_GLOBAL 双重保护
JOB_WORKERS=2
# 全局排队上限；建议按学校安全并发设置 100～500
JOB_PENDING_LIMIT=500
# 任务状态/结果保留时间；队列只保存短期 session，绝不保存密码
JOB_RESULT_TTL_SECONDS=900
# running 状态超过该时间强制置为失败；运行时会取 max(该值, REQUEST_TIMEOUT+30)
JOB_STALE_AFTER_SECONDS=200
# 成绩分析 LLM 的独立并发槽位（所有请求共享每个副本内的上限）
LLM_CONCURRENCY=8
# PDF 生成独立并发槽位；CPU/内存敏感，默认每副本 2
PDF_CONCURRENCY=2
# 查询日志文件通道：JSONL 追加写入，按大小轮转。
# {instance_id} 会替换为实例标识；多副本严禁解析到同一个可轮转文件。
FILE_LOG_ENABLED=true
FILE_LOG_PATH=/var/log/edu-query/{instance_id}/queries.jsonl
FILE_LOG_MAX_BYTES=52428800
FILE_LOG_BACKUP_COUNT=7
# 全站通知：共享 JSONL 文件是权威存储，Redis 仅作可选恢复副本。
# 权威文件必须被多个 format-service 副本共享；Redis 异常不影响通知管理。
NOTICE_FALLBACK_PATH=/var/lib/edu-query/notices/notices.jsonl
NOTICE_ACTIVE_MAX=10
NOTICE_HISTORY_MAX=500
NOTICE_COMPACT_AFTER=2000
# /service-status 文件扫描上限；Redis 聚合可用时不扫描全量历史
SERVICE_STATUS_SCAN_LIMIT=10000
# 管理日志默认扫描上限；管理员可显式提高，但服务端上限为 100000
ADMIN_LOG_SCAN_LIMIT=10000
# /run 总耗时预算；超时后返回可重试的业务失败
REQUEST_TIMEOUT=100
# 全局并发槽位等待秒数；槽位等待超时返回 503
CONCURRENCY_WAIT_TIMEOUT=2
# format-service 同时处理的最大查询数（对学校上游的并发保护）
GLOBAL_CONCURRENCY=4
# 容器时区（影响查询日志 time 字段的偏移）
TZ=Asia/Shanghai
# Python 服务内存护栏与 glibc arena 上限
FORMAT_MEM_LIMIT=256m
# 查询代理包含 LibreOffice；为 PDF 转换预留更高内存
JWXT_MEM_LIMIT=512m
MALLOC_ARENA_MAX=2
# 资源监控宿主机 /proc 只读挂载；Compose 已默认挂载，Docker Desktop 时范围是 Linux VM
HOST_PROC_ROOT=/host/proc
# 资源监控宿主机 cgroup v2 只读挂载；用于聚合整个编排的容器内存
HOST_CGROUP_ROOT=/host/sys/fs/cgroup

# ===== 镜像构建与下载加速 =====
# 镜像仓库前缀：国内环境可填镜像加速站（如 docker.m.daocloud.io 或云镜像仓库），
# 留空则使用 Docker Hub 官方镜像
IMAGE_REGISTRY=
# 构建查询代理时 apt 下载源；国内可改为 https://mirrors.tuna.tsinghua.edu.cn/debian
APT_MIRROR=http://deb.debian.org/debian
# 构建期 pip 下载源（必须是 PyPI 兼容镜像；默认官方源）
PIP_INDEX_URL=https://pypi.org/simple
# 前端本地构建 npm 源（可选）：cd frontend && npm config set registry <镜像> && npm install
# 常用镜像：https://registry.npmmirror.com

# ===== 品牌文案（可选覆盖；留空使用 brand.js 内置默认值）=====
# 页面标题 / 主标题（默认「教务信息查询」）
BRAND_NAME=
# 标题下的一句话定位（默认「汕职院教务信息查询」）
BRAND_SLOGAN=
# 页面 meta description（默认内置说明）
BRAND_DESCRIPTION=
# 页脚版权作者（默认 Lzf07123）
BRAND_AUTHOR=
# 页脚 GitHub 链接（默认 https://github.com/Lzf07123/STPT-Query）；填 none 隐藏该链接
BRAND_GITHUB=

# ===== 对外入口（浏览器可见地址）=====
# frontend 唯一宿主映射端口；修改后同步 PUBLIC_BASE_URL 或使用公网域名
APP_PORT=8000
# 免密登录 /jump/go 与课表下载 /get_schedule/export 链接以此地址生成；
# 生产部署改成公网域名（含 https 与端口），本地默认 127.0.0.1:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ===== 可选容器直连（仅 compose.direct-*.yml 加载时生效）=====
# 默认绑定宿主回环地址；改成 0.0.0.0 前必须自行处理反向代理、TLS 和防火墙。
# 查询代理直连会自动启用 JWXT_ALLOW_GET_CREDENTIALS=0 和 JWXT_PROTECT_LOGIN_STATUS=1。
QUERY_DIRECT_HOST=127.0.0.1
QUERY_DIRECT_PORT=18766
# 格式化后端直连会自动使用 TRUST_PROXY=false。
FORMAT_DIRECT_HOST=127.0.0.1
FORMAT_DIRECT_PORT=18080

# 生产部署前必须改为：ENVIRONMENT=production、AUTO_ROTATE_TOKEN=false、
# 强随机 API_TOKEN/ADMIN_TOKEN/SERVICE_API_TOKEN、JWXT_ALLOW_GET_CREDENTIALS=0、
# JWXT_PROTECT_LOGIN_STATUS=1、JWXT_VERIFY_TLS=1，并把 PUBLIC_BASE_URL 换成 HTTPS 域名。

# ===== 查询代理（get-infomation-service）=====
# 留空时，Compose 内自动指向内部服务 http://get-infomation-service:8766；
# 仅在独立部署（format-service 与查询代理分机）时填公网地址
SERVICE_BASE_URL=
SERVICE_API_TOKEN=change-me
SERVICE_TIMEOUT=60
# 查询代理多副本共享状态；留空 = 单实例内存模式。与上面的 REDIS_URL 可指向同一 Redis。
# 编排内示例：redis://redis:6379/1
JWXT_REDIS_URL=redis://redis:6379/1
# 会话闲置过期小时数；成功使用会自动滑动续期
JWXT_SESSION_TTL_HOURS=1
# 每 IP 每分钟查询/登录请求上限；0 关闭
JWXT_RATE_LIMIT=600
JWXT_LOGIN_RATE_LIMIT=60
# 查询结果与免密签票能力缓存秒数；0 关闭
JWXT_GRADES_CACHE_TTL=300
JWXT_SCHEDULE_CACHE_TTL=300
JWXT_SCHEDULE_PDF_CACHE_TTL=300
JWXT_JUMP_CACHE_TTL=30
# /health 后台真实探测间隔秒数；生产建议 30
JWXT_HEALTH_PROBE_INTERVAL=30
# 上游 TLS 证书校验；1 开启，0 仅在学校证书临时异常时使用
JWXT_VERIFY_TLS=1
# 上游并发保护：单查询并行请求数与全局并发上限
JWXT_UPSTREAM_PARALLEL=4
JWXT_UPSTREAM_GLOBAL=8
# 查询代理进程内查询并发槽位；0 关闭
JWXT_LIMIT_CONCURRENCY=0
# 显式学期列表最多解析学期数
JWXT_MAX_SEMESTERS=20
# 查询代理日志级别：DEBUG/INFO/WARNING/ERROR
JWXT_LOG_LEVEL=INFO
# 允许跨域来源；留空表示仅供后端调用
JWXT_CORS_ORIGIN=
# 安全开关：1 允许 GET 查询串携带凭据；0 要求 /login/status 也携带 Bearer
JWXT_ALLOW_GET_CREDENTIALS=1
JWXT_PROTECT_LOGIN_STATUS=0
# 单实例内存模式上限：避免低流量部署被会话/结果缓存缓慢占满内存
JWXT_MAX_SESSIONS=1000
JWXT_GRADES_CACHE_MAX_ITEMS=1000
JWXT_SCHEDULE_CACHE_MAX_ITEMS=1000
JWXT_SCHEDULE_PDF_CACHE_MAX_ITEMS=8
JWXT_JUMP_CACHE_MAX_ITEMS=1000
# 课表原始文档直接交给容器内 LibreOffice 转为 PDF；并发 1 保护 CPU/内存
JWXT_PDF_TIMEOUT=30
JWXT_PDF_CONCURRENCY=1
JWXT_PDF_MAX_INPUT_MB=5
# 课表查询成功后后台预先生成 PDF；1 开启，0 关闭以降低学校上游负载
JWXT_SCHEDULE_PDF_PREWARM=1
# 学校域名 DNS 故障兜底 IP；生产 DNS 稳定时留空，不建议硬编码默认值
JWXT_DNS_FALLBACK_IPS=
# 前端容器内存护栏
FRONTEND_MEM_LIMIT=64m

# ===== LLM（OpenAI 兼容协议，默认智谱 GLM）=====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash
# 成绩分析：确定性输出 + 长度上限
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
# 成绩分析 LLM 单次请求超时秒数
LLM_TIMEOUT=60
# 智谱 GLM 深度思考开关；关闭可降低延迟，true/false
LLM_ENABLE_THINKING=true
# 覆盖成绩分析系统提示词；留空使用 prompts.py 内置提示词。支持引号包裹的多行文本
LLM_SYSTEM_PROMPT=
