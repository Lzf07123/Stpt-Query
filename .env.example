# ===== 格式化后端（format-service，对外入口）=====
ENVIRONMENT=development
# 静态前端 + 多副本部署要求固定令牌：保持 false，前端与后端共用 API_TOKEN
AUTO_ROTATE_TOKEN=false
API_TOKEN=change-me
# 每 IP 每分钟查询上限
RATE_LIMIT=30

# ===== 查询代理（get-infomation-service）=====
# 对外默认 https://school.lizf.cn；Compose 内自动指向 get-infomation-service:8766
SERVICE_BASE_URL=https://school.lizf.cn
SERVICE_API_TOKEN=change-me
SERVICE_TIMEOUT=60

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 成绩分析：确定性输出 + 长度上限
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
